{
  "name": "tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "prettier": "prettier  --write 'src/**/*.{js,css}'",
    "prepare": "husky",
    "format": "eslint src --fix && prettier --write 'src/**/*.{js,jsx,ts,tsx,css,scss,md}'"
  },

  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,css,scss,md}": [
      "npm run format"
    ]
  },
  
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1"
  }
}
